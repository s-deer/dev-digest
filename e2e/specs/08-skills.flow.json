{
  "name": "Skills page: grid → side preview → skill page tabs",
  "description": "Read-only walk over the seeded skills: the grid renders, a card opens the side preview, Open navigates to /skills/:id, and the Preview and Versioning tabs render the seeded v1. Nothing is created or saved, and no model is called.",
  "steps": [
    { "cmd": ["open", "{BASE}/skills"], "label": "load the skills page" },
    { "cmd": ["wait", "--url", "/skills"], "label": "skills route reached" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "skills fetch settles" },
    { "cmd": ["wait", "--text", "Test Quality Rubric"], "label": "seeded test-quality skill is visible" },
    { "cmd": ["wait", "--text", "API Contract Compatibility"], "label": "seeded API-contract skill is visible" },
    { "cmd": ["find", "text", "Test Quality Rubric", "click"], "label": "open the side preview" },
    { "cmd": ["wait", "--text", "Skill body"], "label": "side preview shows the body" },
    { "cmd": ["find", "role", "button", "click", "--name", "Open"], "label": "open the skill page" },
    { "cmd": ["wait", "--url", "/skills/"], "label": "skill page reached" },
    { "cmd": ["find", "role", "button", "click", "--name", "Preview"], "label": "switch to the Preview tab" },
    { "cmd": ["wait", "--text", "Rendered as the reviewing agent receives it."], "label": "rendered preview is visible" },
    { "cmd": ["find", "role", "button", "click", "--name", "Versioning"], "label": "switch to the Versioning tab" },
    { "cmd": ["wait", "--url", "tab=versioning"], "label": "versioning tab in the URL" },
    { "cmd": ["wait", "--text", "Seeded demo skill"], "label": "seeded v1 snapshot is listed" }
  ]
}
