{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest local MCP server (stdio) — a thin adapter over the Fastify API on :3001. No DB access, no business logic; tools shape and fence API responses for Claude Code.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "inspect": "npx -y @modelcontextprotocol/inspector tsx --tsconfig tsconfig.json src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
